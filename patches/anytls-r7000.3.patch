--- /dev/null
+++ b/proxy/session/client_idle_test.go
@@ -0,0 +1,23 @@
+package session
+
+import (
+	"anytls/proxy/padding"
+	"context"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestFiveSecondIdleTimeoutExpiresSession(t *testing.T) {
+	client := NewClient(context.Background(), nil, &padding.DefaultPaddingFactory, 5*time.Second, 5*time.Second, 0)
+	defer client.Close()
+	conn, peer := net.Pipe()
+	defer peer.Close()
+	session := &Session{conn: conn, die: make(chan struct{}), streams: make(map[uint32]*Stream), idleSince: time.Now().Add(-6 * time.Second)}
+	defer session.Close()
+	client.idleSession.Insert(1, session)
+	client.idleCleanup()
+	if !session.IsClosed() || !client.idleSession.IsEmpty() {
+		t.Fatal("5s idle timeout was ignored or expired session retained")
+	}
+}
