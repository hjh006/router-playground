+++ b/cmd/client/tls_test.go
@@ -0,0 +1,215 @@
+package main
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+func TestTLSConfiguration(t *testing.T) {
+	legacy, err := newTLSConfig("example.test:443", "", "", true)
+	if err != nil || !legacy.InsecureSkipVerify || legacy.ServerName != "127.0.0.1" || len(legacy.NextProtos) != 0 {
+		t.Fatalf("legacy flags changed: config=%+v err=%v", legacy, err)
+	}
+	verified, err := newTLSConfig("example.test:443", "", "h2,http/1.1", false)
+	if err != nil || verified.InsecureSkipVerify || verified.ServerName != "example.test" || strings.Join(verified.NextProtos, ",") != "h2,http/1.1" {
+		t.Fatalf("explicit TLS settings ignored: config=%+v err=%v", verified, err)
+	}
+	for _, alpn := range []string{"h2,", strings.Repeat("x", 256)} {
+		if _, err := newTLSConfig("example.test:443", "", alpn, false); err == nil {
+			t.Errorf("invalid ALPN accepted: length %d", len(alpn))
+		}
+	}
+}
+
+func TestTLSFingerprintNames(t *testing.T) {
+	for value, want := range map[string]string{"": "standard", "standard": "standard", "chrome": "chrome", " Chrome ": "chrome"} {
+		if got, err := parseTLSFingerprint(value); err != nil || got != want {
+			t.Errorf("fingerprint %q = %q, %v; want %q", value, got, err, want)
+		}
+	}
+	if _, err := parseTLSFingerprint("unknown"); err == nil {
+		t.Fatal("unknown fingerprint accepted")
+	}
+}
+
+func TestDialTLSVerificationAndALPN(t *testing.T) {
+	for _, fingerprint := range []string{"standard", "chrome"} {
+		t.Run(fingerprint, func(t *testing.T) { testDialTLSVerificationAndALPN(t, fingerprint) })
+	}
+}
+
+func testDialTLSVerificationAndALPN(t *testing.T, fingerprint string) {
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	server.EnableHTTP2 = true
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.StartTLS()
+	defer server.Close()
+	address := server.Listener.Addr().String()
+
+	config, err := newTLSConfig(address, "", "h2", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.RootCAs = x509.NewCertPool()
+	config.RootCAs.AddCert(server.Certificate())
+	conn, err := dialTLS(context.Background(), address, config, fingerprint, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var protocol string
+	switch conn := conn.(type) {
+	case *tls.Conn:
+		protocol = conn.ConnectionState().NegotiatedProtocol
+	case *utls.UConn:
+		protocol = conn.ConnectionState().NegotiatedProtocol
+	}
+	if got := protocol; got != "h2" {
+		t.Fatalf("negotiated ALPN = %q, want h2", got)
+	}
+	conn.Close()
+
+	config.RootCAs = x509.NewCertPool()
+	if conn, err := dialTLS(context.Background(), address, config, fingerprint, time.Second); err == nil {
+		conn.Close()
+		t.Fatal("untrusted server accepted with insecure=false")
+	} else {
+		var unknownAuthority x509.UnknownAuthorityError
+		if !errors.As(err, &unknownAuthority) {
+			t.Fatalf("expected certificate verification error, got %v", err)
+		}
+	}
+	config.InsecureSkipVerify = true
+	conn, err = dialTLS(context.Background(), address, config, fingerprint, time.Second)
+	if err != nil {
+		t.Fatalf("explicit insecure=true did not work: %v", err)
+	}
+	conn.Close()
+}
+
+func TestHandshakeContextDoesNotCancelEstablishedConnection(t *testing.T) {
+	for _, fingerprint := range []string{"standard", "chrome"} {
+		t.Run(fingerprint, func(t *testing.T) { testEstablishedTLSConnection(t, fingerprint) })
+	}
+}
+
+func testEstablishedTLSConnection(t *testing.T, fingerprint string) {
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	config, _ := newTLSConfig(server.Listener.Addr().String(), "", "", true)
+	conn, err := dialTLS(context.Background(), server.Listener.Addr().String(), config, fingerprint, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(time.Second))
+	if _, err := io.WriteString(conn, "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusNoContent {
+		t.Fatalf("status = %d, want 204", response.StatusCode)
+	}
+}
+
+func TestTLSHandshakeTimeoutClosesSocket(t *testing.T) {
+	for _, fingerprint := range []string{"standard", "chrome"} {
+		t.Run(fingerprint, func(t *testing.T) { testTLSHandshakeTimeout(t, fingerprint) })
+	}
+}
+
+func testTLSHandshakeTimeout(t *testing.T, fingerprint string) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	peerClosed := make(chan struct{})
+	go func() {
+		conn, err := listener.Accept()
+		if err == nil {
+			defer conn.Close()
+			conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+			io.Copy(io.Discard, conn)
+		}
+		close(peerClosed)
+	}()
+	config, _ := newTLSConfig(listener.Addr().String(), "", "", true)
+	started := time.Now()
+	conn, err := dialTLS(context.Background(), listener.Addr().String(), config, fingerprint, 100*time.Millisecond)
+	if conn != nil {
+		conn.Close()
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("expected handshake deadline, got %v", err)
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("handshake timeout took %s", elapsed)
+	}
+	select {
+	case <-peerClosed:
+	case <-time.After(time.Second):
+		t.Fatal("timed-out TLS socket was not closed")
+	}
+}
+
+func TestChromeClientHelloPreservesExplicitALPN(t *testing.T) {
+	for _, alpn := range []string{"h2", "http/1.1"} {
+		t.Run(alpn, func(t *testing.T) {
+			type hello struct {
+				protocols []string
+				ciphers   []uint16
+				server    string
+			}
+			seen := make(chan hello, 1)
+			server := httptest.NewUnstartedServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+			server.EnableHTTP2 = true
+			server.Config.ErrorLog = log.New(io.Discard, "", 0)
+			server.TLS = &tls.Config{GetConfigForClient: func(info *tls.ClientHelloInfo) (*tls.Config, error) {
+				seen <- hello{append([]string(nil), info.SupportedProtos...), append([]uint16(nil), info.CipherSuites...), info.ServerName}
+				return nil, nil
+			}}
+			server.StartTLS()
+			defer server.Close()
+			config, _ := newTLSConfig(server.Listener.Addr().String(), "example.com", alpn, false)
+			config.RootCAs = x509.NewCertPool()
+			config.RootCAs.AddCert(server.Certificate())
+			conn, err := dialTLS(context.Background(), server.Listener.Addr().String(), config, "chrome", time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			actual := <-seen
+			if strings.Join(actual.protocols, ",") != alpn || actual.server != "example.com" {
+				t.Fatalf("wire ClientHello changed configured ALPN/SNI: %+v", actual)
+			}
+			grease := false
+			for _, cipher := range actual.ciphers {
+				grease = grease || cipher&0x0f0f == 0x0a0a
+			}
+			if !grease {
+				t.Fatal("wire ClientHello lacks the Chrome profile's GREASE cipher")
+			}
+		})
+	}
+}
