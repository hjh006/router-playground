index 0000000..8d904a6
--- /dev/null
+++ b/cmd/client/settings.go
@@ -0,0 +1,22 @@
+package main
+
+import (
+	"fmt"
+	"time"
+)
+
+func validateClientSettings(minIdle int, handshake, idleCheck, idleTimeout time.Duration) error {
+	if minIdle < 0 || minIdle > 20 {
+		return fmt.Errorf("m must be between 0 and 20")
+	}
+	if handshake < 3*time.Second || handshake > 20*time.Second {
+		return fmt.Errorf("handshake-timeout must be between 3s and 20s")
+	}
+	if idleCheck < 5*time.Second || idleCheck > 300*time.Second {
+		return fmt.Errorf("idle-check must be between 5s and 300s")
+	}
+	if idleTimeout < 5*time.Second || idleTimeout > 600*time.Second {
+		return fmt.Errorf("idle-timeout must be between 5s and 600s")
+	}
+	return nil
+}
