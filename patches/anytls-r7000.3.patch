diff --git a/proxy/session/session_close_test.go b/proxy/session/session_close_test.go
new file mode 100644
index 0000000..ac232ad
--- /dev/null
+++ b/proxy/session/session_close_test.go
@@ -0,0 +1,31 @@
+package session
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+func TestCloseUnblocksSocketBeforeShutdownHook(t *testing.T) {
+	conn, peer := net.Pipe()
+	defer peer.Close()
+	readDone := make(chan struct{})
+	go func() {
+		conn.Read(make([]byte, 1))
+		close(readDone)
+	}()
+	session := &Session{conn: conn, die: make(chan struct{}), streams: make(map[uint32]*Stream)}
+	session.dieHook = func() {
+		select {
+		case <-readDone:
+		case <-time.After(time.Second):
+			t.Error("socket read still blocked inside shutdown hook")
+		}
+	}
+	if err := session.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if !session.IsClosed() {
+		t.Fatal("session remained open")
+	}
+}
