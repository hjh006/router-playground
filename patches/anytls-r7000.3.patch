@@ -0,0 +1,34 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func TestClientSettingBounds(t *testing.T) {
+	for _, settings := range []struct {
+		name                   string
+		minIdle                int
+		handshake, check, idle time.Duration
+		valid                  bool
+	}{
+		{"minimum", 0, 3 * time.Second, 5 * time.Second, 5 * time.Second, true},
+		{"maximum", 20, 20 * time.Second, 300 * time.Second, 600 * time.Second, true},
+		{"defaults", 5, 8 * time.Second, 30 * time.Second, 30 * time.Second, true},
+		{"negative idle count", -1, 8 * time.Second, 30 * time.Second, 30 * time.Second, false},
+		{"too many idle sessions", 21, 8 * time.Second, 30 * time.Second, 30 * time.Second, false},
+		{"short handshake", 0, 3*time.Second - time.Nanosecond, 30 * time.Second, 30 * time.Second, false},
+		{"long handshake", 0, 20*time.Second + time.Nanosecond, 30 * time.Second, 30 * time.Second, false},
+		{"short check", 0, 8 * time.Second, 5*time.Second - time.Nanosecond, 30 * time.Second, false},
+		{"long check", 0, 8 * time.Second, 300*time.Second + time.Nanosecond, 30 * time.Second, false},
+		{"short idle timeout", 0, 8 * time.Second, 30 * time.Second, 5*time.Second - time.Nanosecond, false},
+		{"long idle timeout", 0, 8 * time.Second, 30 * time.Second, 600*time.Second + time.Nanosecond, false},
+	} {
+		t.Run(settings.name, func(t *testing.T) {
+			err := validateClientSettings(settings.minIdle, settings.handshake, settings.check, settings.idle)
+			if (err == nil) != settings.valid {
+				t.Fatalf("validation error = %v, want valid=%v", err, settings.valid)
+			}
+		})
+	}
+}
diff --git a/cmd/client/tls.go b/cmd/client/tls.go
new file mode 100644
index 0000000..06ee6c9
--- /dev/null
+++ b/cmd/client/tls.go
@@ -0,0 +1,121 @@
+package main
+
+import (
+	"anytls/proxy"
+	"context"
+	"crypto/tls"
+	"fmt"
+	"net"
+	"strings"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+func newTLSConfig(serverAddr, serverName, alpn string, insecure bool) (*tls.Config, error) {
+	if serverName == "" {
+		if insecure {
+			// Preserve the original client's no-SNI behavior for legacy flags.
+			serverName = "127.0.0.1"
+		} else {
+			var err error
+			serverName, _, err = net.SplitHostPort(serverAddr)
+			if err != nil {
+				return nil, fmt.Errorf("invalid TLS server address: %w", err)
+			}
+		}
+	}
+	config := &tls.Config{ServerName: serverName, InsecureSkipVerify: insecure}
+	if alpn != "" {
+		for _, protocol := range strings.Split(alpn, ",") {
+			protocol = strings.TrimSpace(protocol)
+			if len(protocol) == 0 || len(protocol) > 255 {
+				return nil, fmt.Errorf("ALPN protocol length must be 1..255 bytes")
+			}
+			config.NextProtos = append(config.NextProtos, protocol)
+		}
+	}
+	return config, nil
+}
+
+func parseTLSFingerprint(value string) (string, error) {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "standard":
+		return "standard", nil
+	case "chrome":
+		return "chrome", nil
+	default:
+		return "", fmt.Errorf("TLS fingerprint must be standard or chrome")
+	}
+}
+
+func chromeTLSClient(conn net.Conn, config *tls.Config) (*utls.UConn, error) {
+	client := utls.UClient(conn, &utls.Config{
+		ServerName: config.ServerName, InsecureSkipVerify: config.InsecureSkipVerify,
+		RootCAs: config.RootCAs, NextProtos: append([]string(nil), config.NextProtos...),
+		MinVersion: config.MinVersion, MaxVersion: config.MaxVersion, KeyLogWriter: config.KeyLogWriter,
+	}, utls.HelloChrome_Auto)
+	if err := client.BuildHandshakeState(); err != nil {
+		return nil, err
+	}
+	if len(config.NextProtos) > 0 {
+		// Browser presets carry their own ALPN. Retain the explicit profile settings.
+		extensions := client.Extensions[:0]
+		for _, extension := range client.Extensions {
+			switch extension := extension.(type) {
+			case *utls.ALPNExtension:
+				extension.AlpnProtocols = append([]string(nil), config.NextProtos...)
+			case *utls.ApplicationSettingsExtension:
+				protocols := extension.SupportedProtocols[:0]
+				for _, supported := range extension.SupportedProtocols {
+					for _, allowed := range config.NextProtos {
+						if supported == allowed {
+							protocols = append(protocols, supported)
+						}
+					}
+				}
+				extension.SupportedProtocols = protocols
+				if len(protocols) == 0 {
+					continue
+				}
+			}
+			extensions = append(extensions, extension)
+		}
+		client.Extensions = extensions
+	}
+	return client, nil
+}
+
+func dialTLS(ctx context.Context, serverAddr string, config *tls.Config, fingerprint string, timeout time.Duration) (net.Conn, error) {
+	if timeout <= 0 {
+		return nil, fmt.Errorf("TLS handshake timeout must be positive")
+	}
+	fingerprint, err := parseTLSFingerprint(fingerprint)
+	if err != nil {
+		return nil, err
+	}
+	conn, err := proxy.SystemDialer.DialContext(ctx, "tcp", serverAddr)
+	if err != nil {
+		return nil, fmt.Errorf("TCP dial: %w", err)
+	}
+	handshakeCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	var tlsConn interface {
+		net.Conn
+		HandshakeContext(context.Context) error
+	}
+	if fingerprint == "chrome" {
+		tlsConn, err = chromeTLSClient(conn, config)
+		if err != nil {
+			conn.Close()
+			return nil, fmt.Errorf("TLS ClientHello: %w", err)
+		}
+	} else {
+		tlsConn = tls.Client(conn, config)
+	}
+	if err := tlsConn.HandshakeContext(handshakeCtx); err != nil {
+		tlsConn.Close()
+		return nil, fmt.Errorf("TLS handshake: %w", err)
+	}
+	return tlsConn, nil
+}
