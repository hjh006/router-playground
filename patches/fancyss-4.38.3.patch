diff --git a/shadowsocks/ss/ssconfig.sh b/shadowsocks/ss/ssconfig.sh
index 758ed7a..f587ab0 100755
--- a/shadowsocks/ss/ssconfig.sh
+++ b/shadowsocks/ss/ssconfig.sh
@@ -3,7 +3,134 @@
 # shadowsocks script for AM380 merlin firmware
 # by sadog (sadoneli@gmail.com) from koolshare.cn
 
-eval `dbus export ss`
+# Acquire the service lock before reading DBus. A waiting restart must never
+# apply the configuration snapshot from before a manual switch or stop.
+LOCK_FILE=/var/lock/koolss.lock
+SS_SERVICE_LOCKED=0
+set_lock(){
+	[ "$SS_SERVICE_LOCKED" = 1 ] && return 0
+	exec 7>"$LOCK_FILE"
+	/koolshare/bin/ss-flock -x 7 || exit 1
+	SS_SERVICE_LOCKED=1
+}
+unset_lock(){
+	[ "$SS_SERVICE_LOCKED" = 1 ] || return 0
+	/koolshare/bin/ss-flock -u 7
+	exec 7>&-
+	SS_SERVICE_LOCKED=0
+}
+set_lock
+trap 'unset_lock' EXIT
+trap 'exit 129' HUP
+trap 'exit 130' INT
+trap 'exit 143' TERM
+SS_FAILOVER_ACTION=${1:-}
+SS_FAILOVER_STATE=/tmp/ss_failover
+ss_failover_guard(){
+	case "$SS_FAILOVER_EXPECTED" in ''|*[!0-9]*) return 75 ;; esac
+	[ "${#SS_FAILOVER_EXPECTED}" -le 6 ] || return 75
+	case "$SS_FAILOVER_GENERATION" in ''|*[!A-Za-z0-9._-]*) return 75 ;; esac
+	[ "${#SS_FAILOVER_GENERATION}" -le 64 ] || return 75
+	[ ! -L "$SS_FAILOVER_STATE" ] && [ ! -L "$SS_FAILOVER_STATE/generation" ] || return 75
+	[ "$(dbus get ss_basic_enable)" = 1 ] && [ "$(dbus get ss_basic_failover_enable)" = 1 ] &&
+	[ "$(dbus get ss_basic_type)" = 4 ] && [ "$(dbus get ss_basic_trojan_binary)" = AnyTLS ] &&
+	[ "$(dbus get ssconf_basic_node)" = "$SS_FAILOVER_EXPECTED" ] &&
+	[ "$(cat "$SS_FAILOVER_STATE/generation" 2>/dev/null)" = "$SS_FAILOVER_GENERATION" ]
+}
+ss_failover_set_mode(){
+	local temporary rc=0
+	[ ! -L "$SS_FAILOVER_STATE" ] || return 1
+	mkdir -p "$SS_FAILOVER_STATE" && chmod 700 "$SS_FAILOVER_STATE" || return 1
+	[ ! -L "$SS_FAILOVER_STATE/commit.lock" ] || return 1
+	exec 6>"$SS_FAILOVER_STATE/commit.lock"
+	/koolshare/bin/ss-flock -x 6 || { exec 6>&-; return 1; }
+	temporary=$(/koolshare/bin/ss-flock mktemp "$SS_FAILOVER_STATE/mode.XXXXXX") || rc=1
+	if [ "$rc" = 0 ]; then
+		printf '%s\n' "$1" > "$temporary" && chmod 600 "$temporary" && mv -f "$temporary" "$SS_FAILOVER_STATE/mode" || rc=1
+	fi
+	/koolshare/bin/ss-flock -u 6
+	exec 6>&-
+	return "$rc"
+}
+ss_failover_select(){
+	local id=$1 field value snapshot rc=0
+	case "$id" in ''|*[!0-9]*) return 1 ;; esac
+	[ "${#id}" -le 6 ] && [ "$id" -ge 1 ] && [ "$id" -le 999999 ] || return 1
+	[ "$(dbus get ssconf_basic_type_$id)" = 4 ] && [ "$(dbus get ssconf_basic_trojan_binary_$id)" = AnyTLS ] || return 1
+	value=$(dbus get ssconf_basic_port_$id)
+	case "$value" in ''|*[!0-9]*) return 1 ;; esac
+	[ "${#value}" -le 5 ] && [ "$value" -ge 1 ] && [ "$value" -le 65535 ] || return 1
+	[ -n "$(dbus get ssconf_basic_server_$id)" ] && [ -n "$(dbus get ssconf_basic_password_$id)" ] || return 1
+	ss_failover_guard || return 75
+	# Temporary snapshots are private and removed on success or rollback. Never
+	# eval node values, and publish the selected ID only after every field lands.
+	snapshot=$(/koolshare/bin/ss-flock mktemp "$SS_FAILOVER_STATE/selection.XXXXXX") || return 1
+	rm -f "$snapshot" && mkdir -m 700 "$snapshot" || return 1
+	for field in server port password trojan_sni allowinsecure use_kcp type trojan_binary; do
+		dbus get "ss_basic_$field" > "$snapshot/$field" || { rm -rf "$snapshot"; return 1; }
+	done
+	for field in server port password trojan_sni allowinsecure use_kcp type trojan_binary; do
+		ss_failover_guard || { rm -rf "$snapshot"; return 75; }
+		value=$(dbus get "ssconf_basic_${field}_$id")
+		case "$field" in allowinsecure|use_kcp) [ "$value" = 1 ] || value=0 ;; esac
+		dbus set "ss_basic_$field=$value" || { rc=1; break; }
+	done
+	ss_failover_guard || { rm -rf "$snapshot"; return 75; }
+	if [ "$rc" = 0 ]; then dbus set "ssconf_basic_node=$id" || rc=1; fi
+	if [ "$rc" != 0 ]; then
+		for field in server port password trojan_sni allowinsecure use_kcp type trojan_binary; do
+			dbus set "ss_basic_$field=$(cat "$snapshot/$field")" || :
+		done
+	fi
+	rm -rf "$snapshot"
+	[ "$rc" = 0 ] && SS_FAILOVER_EXPECTED=$id
+	return "$rc"
+}
+case "$SS_FAILOVER_ACTION" in
+failover-switch)
+	[ "$#" = 4 ] || exit 75
+	SS_FAILOVER_TARGET=$2 SS_FAILOVER_EXPECTED=$3 SS_FAILOVER_GENERATION=$4
+	ss_failover_guard || exit 75
+	;;
+failover-direct)
+	[ "$#" = 3 ] || exit 75
+	SS_FAILOVER_EXPECTED=$2 SS_FAILOVER_GENERATION=$3
+	ss_failover_guard || exit 75
+	;;
+esac
+
+. /koolshare/scripts/ss_routing.sh
+if [ "$SS_FAILOVER_ACTION" != stop ] && ! ss_routing_load_bypass_macs; then
+	printf '%s\n' 'Invalid or overlapping device MAC profiles; no routing changes were applied.' >&2
+	exit 1
+fi
+if [ "$SS_FAILOVER_ACTION" != stop ] && ! sh /koolshare/scripts/ss_anytls.sh validate-hosts; then
+	printf '%s\n' 'Invalid AnyTLS Hosts mappings; no routing changes were applied.' >&2
+	exit 1
+fi
+. /koolshare/scripts/ss_dns_hooks.sh
+case "$SS_FAILOVER_ACTION" in stop|failover-direct) ;;
+*)
+	if [ "$(dbus get ss_basic_type)" = 4 ] && [ "$(dbus get ss_basic_trojan_binary)" = AnyTLS ] && [ "$(dbus get ss_basic_server_resolver)" = 12 ]; then
+		ss_dns_normalize_resolver "$(dbus get ss_basic_server_resolver_user)" >/dev/null || { printf '%s\n' 'Invalid node DNS endpoint; no service changes were applied.' >&2; exit 1; }
+	fi ;;
+esac
+if [ "${1:-}" != stop ]; then
+	sh /koolshare/scripts/ss_failover.sh validate || { printf '%s\n' 'Invalid failover settings; no service changes were applied.' >&2; exit 1; }
+fi
+case "$SS_FAILOVER_ACTION" in stop|failover-direct) ;;
+*) sh /koolshare/scripts/ss_adblock.sh validate || { printf '%s\n' 'Invalid ad-filter settings; no service changes were applied.' >&2; exit 1; } ;;
+esac
+if [ "$SS_FAILOVER_ACTION" = failover-switch ]; then
+	ss_failover_select "$SS_FAILOVER_TARGET" || exit $?
+fi
+if [ "$SS_FAILOVER_ACTION" = stop ]; then
+	# Cleanup needs no node credentials or unvalidated profile snapshot.
+	ss_basic_dnsmasq_fastlookup=$(dbus get ss_basic_dnsmasq_fastlookup)
+	case "$ss_basic_dnsmasq_fastlookup" in 0|1|2|3) ;; *) ss_basic_dnsmasq_fastlookup=0 ;; esac
+else
+	eval `dbus export ss`
+fi
 source /koolshare/scripts/base.sh
 source helper.sh
 # Variable definitions
